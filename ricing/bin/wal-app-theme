#!/usr/bin/env python3
"""Render Yazi and Zen Browser UI colours from Pywal's current palette."""

from __future__ import annotations

import json
from pathlib import Path


HOME = Path.home()
WAL_COLORS = HOME / ".cache/wal/colors.json"


def main() -> None:
    try:
        palette = json.loads(WAL_COLORS.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise SystemExit(f"wal-app-theme: cannot read {WAL_COLORS}: {error}")

    special = palette.get("special", {})
    colors = palette.get("colors", {})
    background = special.get("background", "#171717")
    foreground = special.get("foreground", "#f5f5f5")
    primary = colors.get("color4", foreground)
    secondary = colors.get("color5", primary)
    muted = colors.get("color8", "#999999")
    success = colors.get("color2", "#7bcf8a")
    warning = colors.get("color3", "#e9b45c")
    error = colors.get("color1", "#e06c75")
    surface = colors.get("color0", background)
    surface_high = colors.get("color8", surface)

    yazi = f'''# Generated by wal-app-theme. Do not edit.
[app]
overall = {{ bg = "{background}" }}

[indicator]
parent = {{ fg = "{muted}" }}
current = {{ fg = "{background}", bg = "{primary}", bold = true }}
preview = {{ fg = "{secondary}" }}

padding = {{ open = "", close = "" }}

[tabs]
active = {{ fg = "{background}", bg = "{primary}", bold = true }}
inactive = {{ fg = "{muted}", bg = "{surface}" }}

[mode]
normal_main = {{ fg = "{background}", bg = "{primary}", bold = true }}
normal_alt = {{ fg = "{primary}", bg = "{surface}" }}
select_main = {{ fg = "{background}", bg = "{secondary}", bold = true }}
select_alt = {{ fg = "{secondary}", bg = "{surface}" }}
unset_main = {{ fg = "{background}", bg = "{muted}", bold = true }}
unset_alt = {{ fg = "{muted}", bg = "{surface}" }}

[which]
cand = {{ fg = "{primary}", bold = true }}
desc = {{ fg = "{foreground}" }}
rest = {{ fg = "{muted}" }}

[confirm]
border = {{ fg = "{primary}" }}
title = {{ fg = "{foreground}", bold = true }}
btn_yes = {{ fg = "{background}", bg = "{success}" }}
btn_no = {{ fg = "{background}", bg = "{error}" }}

[notify]
title_info = {{ fg = "{primary}" }}
title_warn = {{ fg = "{warning}" }}
title_error = {{ fg = "{error}" }}

[filetype]
rules = [
  {{ mime = "image/*", fg = "{warning}" }},
  {{ mime = "{{audio,video}}/*", fg = "{secondary}" }},
  {{ mime = "application/*", fg = "{primary}" }},
  {{ url = "*", is = "orphan", fg = "{error}" }},
  {{ url = "*/", fg = "{primary}" }},
]
'''
    yazi_path = HOME / ".config/yazi/theme.toml"
    yazi_path.parent.mkdir(parents=True, exist_ok=True)
    yazi_path.write_text(yazi, encoding="utf-8")

    starship = f'''# Generated by wal-app-theme. Do not edit.
format = """$directory$git_branch$git_status$nodejs$python$rust$golang$cmd_duration
$character"""
add_newline = true

[directory]
style = "bold {primary}"
truncation_length = 4

[git_branch]
style = "bold {secondary}"
symbol = " "

[git_status]
style = "bold {warning}"

[nodejs]
style = "{success}"
symbol = " "

[python]
style = "{warning}"
symbol = " "

[rust]
style = "{error}"
symbol = "󱘗 "

[golang]
style = "{primary}"
symbol = " "

[cmd_duration]
style = "{muted}"
min_time = 500

[character]
success_symbol = "[❯]({primary})"
error_symbol = "[❯]({error})"
'''
    (HOME / ".config/starship.toml").write_text(starship, encoding="utf-8")

    zsh = f'''# Generated by wal-app-theme. Do not edit.
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg={muted}'
typeset -gA ZSH_HIGHLIGHT_STYLES
ZSH_HIGHLIGHT_STYLES[command]='fg={primary},bold'
ZSH_HIGHLIGHT_STYLES[builtin]='fg={secondary},bold'
ZSH_HIGHLIGHT_STYLES[function]='fg={secondary}'
ZSH_HIGHLIGHT_STYLES[alias]='fg={primary},bold'
ZSH_HIGHLIGHT_STYLES[path]='fg={foreground},underline'
ZSH_HIGHLIGHT_STYLES[unknown-token]='fg={error},bold'
ZSH_HIGHLIGHT_STYLES[globbing]='fg={warning}'
'''
    zsh_path = HOME / ".config/ricing/generated/zsh-theme.zsh"
    zsh_path.parent.mkdir(parents=True, exist_ok=True)
    zsh_path.write_text(zsh, encoding="utf-8")

    zen_profiles = list((HOME / ".config/zen").glob("*.Default*"))
    zen_css = f'''/* Generated by wal-app-theme. Do not edit. */
@namespace url("http://www.mozilla.org/keymaster/gatekeeper/there.is.only.xul");

:root {{
  --wal-bg: {background};
  --wal-surface: {surface};
  --wal-fg: {foreground};
  --wal-muted: {muted};
  --wal-primary: {primary};
  --wal-secondary: {secondary};
}}

#navigator-toolbox, #titlebar, #TabsToolbar, #nav-bar, #PersonalToolbar,
#zen-sidebar-top-buttons, #zen-appcontent-wrapper {{
  background-color: var(--wal-bg) !important;
  color: var(--wal-fg) !important;
}}

.tab-background[selected], .tabbrowser-tab[selected] .tab-background {{
  background-color: var(--wal-surface) !important;
  outline: 1px solid color-mix(in srgb, var(--wal-primary) 45%, transparent) !important;
}}

.tabbrowser-tab:hover > .tab-stack > .tab-background,
toolbarbutton:hover, .toolbarbutton-1:hover {{
  background-color: color-mix(in srgb, var(--wal-primary) 18%, transparent) !important;
}}

#urlbar, #searchbar, .urlbarView, .urlbarView-body-outer,
menupopup, panel, .panel-arrowcontent {{
  background-color: var(--wal-surface) !important;
  color: var(--wal-fg) !important;
  border-color: color-mix(in srgb, var(--wal-primary) 35%, transparent) !important;
}}

#urlbar[focused], #searchbar:focus-within {{
  outline: 2px solid var(--wal-primary) !important;
  outline-offset: -1px !important;
}}

.tab-label, #urlbar-input, .urlbarView-row, menuitem, menu {{
  color: var(--wal-fg) !important;
}}

.tab-secondary-label, #urlbar-input::placeholder {{
  color: var(--wal-muted) !important;
}}
'''
    for profile in zen_profiles:
        chrome = profile / "chrome"
        chrome.mkdir(parents=True, exist_ok=True)
        (chrome / "userChrome.css").write_text(zen_css, encoding="utf-8")

        user_js = profile / "user.js"
        preference = 'user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);\n'
        current = user_js.read_text(encoding="utf-8") if user_js.exists() else ""
        if "toolkit.legacyUserProfileCustomizations.stylesheets" not in current:
            user_js.write_text(current + preference, encoding="utf-8")


if __name__ == "__main__":
    main()
